{
  "name": "classroom-booking-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:push": "prisma db push",
    "db:reset": "node scripts/reset-and-seed.js",
    "db:seed": "tsx prisma/seed.ts",
